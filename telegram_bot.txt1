import asyncio
import gc
import glob
import json
import os
import stat
import threading
import time
from datetime import datetime
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import ApplicationBuilder, CommandHandler, CallbackQueryHandler, ContextTypes
from telethon import TelegramClient
from telethon.errors import SessionPasswordNeededError

class TelegramBot:
    def __init__(self):
        # BotFather token - Environment variable'dan oku, yoksa default kullan
        self.BOT_TOKEN = os.getenv('BOT_TOKEN', "8023451077:AAGlCOPYNIg0Iuy2Vz7ZqA5zm_Jqv2vfnnc")
        
        # YÖNETİCİ ID'Sİ - Environment variable'dan oku, yoksa default kullan
        self.ADMIN_ID = int(os.getenv('ADMIN_ID', '6615127610'))
        
        # Klasörler
        self.users_dir = 'bot_users'
        self.ensure_users_directory()
        
        # Bot durumları
        self.user_states = {}
        self.telethon_clients = {}
        self.active_tasks = {}
        self.app = None
        
        # Cloud platform detection
        self.is_cloud_platform = self.detect_cloud_platform()
        self.heartbeat_task = None
        
        # Onaylı kullanıcılar listesi
        self.approved_users = set()
        self.load_approved_users()
        
        # Thread lock dosya işlemleri için
        self.file_lock = threading.Lock()
        self.session_locks = {}  # Her kullanıcı için ayrı lock
    
    def detect_cloud_platform(self):
        """Cloud platform (Railway, Heroku, Render) detection"""
        cloud_indicators = [
            'RAILWAY_ENVIRONMENT',
            'DYNO',  # Heroku
            'RENDER',
            'RAILWAY_PROJECT_ID',
            'HEROKU_APP_NAME',
            'RENDER_SERVICE_ID'
        ]
        
        is_cloud = any(os.getenv(indicator) for indicator in cloud_indicators)
        if is_cloud:
            print("☁️ Cloud platform algılandı - 7/24 aktif mod")
        else:
            print("💻 Local platform - Normal mod")
        return is_cloud
    
    async def start_heartbeat(self):
        """Railway/Cloud platform için heartbeat sistemi"""
        if not self.is_cloud_platform:
            return
            
        print("💓 Heartbeat sistemi başlatılıyor...")
        
        async def heartbeat_loop():
            heartbeat_count = 0
            while True:
                try:
                    # Her 5 dakikada bir heartbeat
                    await asyncio.sleep(300)  # 5 dakika
                    heartbeat_count += 1
                    
                    # Log heartbeat
                    print(f"💓 Heartbeat #{heartbeat_count} - {datetime.now().strftime('%H:%M:%S')}")
                    
                    # Aktif task'ları kontrol et
                    active_count = len(self.active_tasks)
                    if active_count > 0:
                        print(f"🔄 Aktif otomatik gönderim: {active_count}")
                    
                    # Memory temizliği (her 1 saatte bir)
                    if heartbeat_count % 12 == 0:
                        print("🧹 Memory temizliği...")
                        import gc
                        gc.collect()
                        
                except Exception as e:
                    print(f"❌ Heartbeat hatası: {str(e)}")
                    await asyncio.sleep(60)  # Hata durumunda 1 dakika bekle
        
        self.heartbeat_task = asyncio.create_task(heartbeat_loop())
    
    def get_user_session_lock(self, user_id):
        """Kullanıcı için session lock al"""
        if user_id not in self.session_locks:
            self.session_locks[user_id] = threading.Lock()
        return self.session_locks[user_id]
    
    def get_safe_session_file(self, user_id):
        """Güvenli session dosya yolu"""
        return os.path.join(self.users_dir, f'user_{user_id}_session.session')
        
    def ensure_users_directory(self):
        """Kullanıcı klasörünü oluştur"""
        if not os.path.exists(self.users_dir):
            os.makedirs(self.users_dir)
    
    def get_approved_users_file(self):
        """Onaylı kullanıcılar dosya yolu"""
        return os.path.join(self.users_dir, 'approved_users.json')
    
    def load_approved_users(self):
        """Onaylı kullanıcıları yükle"""
        approved_file = self.get_approved_users_file()
        if os.path.exists(approved_file):
            try:
                with open(approved_file, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                    self.approved_users = set(data.get('approved_users', []))
            except:
                self.approved_users = set()
        else:
            self.approved_users = set()
        
        # Yöneticiyi otomatik onaylı listesine ekle
        self.approved_users.add(self.ADMIN_ID)
    
    def save_approved_users(self):
        """Onaylı kullanıcıları kaydet"""
        approved_file = self.get_approved_users_file()
        data = {
            'approved_users': list(self.approved_users),
            'last_updated': datetime.now().isoformat()
        }
        with open(approved_file, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    
    def save_bot_state(self):
        """Bot durumunu kaydet (Cloud platform için)"""
        if not self.is_cloud_platform:
            return
            
        try:
            state_file = os.path.join(self.users_dir, 'bot_state.json')
            state_data = {
                'active_auto_sends': list(self.active_tasks.keys()),
                'last_save': datetime.now().isoformat(),
                'heartbeat_active': self.heartbeat_task is not None and not self.heartbeat_task.done()
            }
            
            with open(state_file, 'w', encoding='utf-8') as f:
                json.dump(state_data, f, ensure_ascii=False, indent=2)
                
        except Exception as e:
            print(f"⚠️ Bot durumu kaydetme hatası: {str(e)}")
    
    def load_bot_state(self):
        """Bot durumunu yükle (Cloud platform için)"""
        if not self.is_cloud_platform:
            return []
            
        try:
            state_file = os.path.join(self.users_dir, 'bot_state.json')
            if os.path.exists(state_file):
                with open(state_file, 'r', encoding='utf-8') as f:
                    state_data = json.load(f)
                    return state_data.get('active_auto_sends', [])
        except Exception as e:
            print(f"⚠️ Bot durumu yükleme hatası: {str(e)}")
        
        return []
    
    def is_user_approved(self, user_id):
        """Kullanıcının onaylı olup olmadığını kontrol et"""
        # Önce banned kontrolü yap
        user_data = self.load_user_data(user_id)
        if user_data.get('approval_status') == 'banned':
            return False
        
        return user_id in self.approved_users

    def is_user_banned(self, user_id):
        """Kullanıcının yasaklı olup olmadığını kontrol et"""
        user_data = self.load_user_data(user_id)
        return user_data.get('approval_status') == 'banned'
    
    def approve_user(self, user_id):
        """Kullanıcıyı onayla"""
        self.approved_users.add(user_id)
        self.save_approved_users()
        
        # Onay tarihini kullanıcı verilerine kaydet
        user_data = self.load_user_data(user_id)
        user_data['approved_date'] = datetime.now().isoformat()
        user_data['approval_status'] = 'approved'
        self.save_user_data(user_id, user_data)
    
    def reject_user(self, user_id):
        """Kullanıcı onayını reddet"""
        if user_id in self.approved_users:
            self.approved_users.remove(user_id)
            self.save_approved_users()
        
        # Red tarihini kaydet
        user_data = self.load_user_data(user_id)
        user_data['rejected_date'] = datetime.now().isoformat()
        user_data['approval_status'] = 'rejected'
        self.save_user_data(user_id, user_data)

    def ban_user(self, user_id):
        """Kullanıcıyı banla"""
        if user_id in self.approved_users:
            self.approved_users.remove(user_id)
            self.save_approved_users()
        
        # Ban tarihini kaydet
        user_data = self.load_user_data(user_id)
        user_data['banned_date'] = datetime.now().isoformat()
        user_data['approval_status'] = 'banned'
        self.save_user_data(user_id, user_data)

    def unban_user(self, user_id):
        """Kullanıcının banını kaldır"""
        self.approved_users.add(user_id)
        self.save_approved_users()
        
        # Unban tarihini kaydet
        user_data = self.load_user_data(user_id)
        user_data['unbanned_date'] = datetime.now().isoformat()
        user_data['approval_status'] = 'approved'
        self.save_user_data(user_id, user_data)
    
    def get_user_file(self, user_id):
        """Kullanıcı dosya yolu"""
        return os.path.join(self.users_dir, f'user_{user_id}.json')
    
    def save_user_data(self, user_id, data):
        """Kullanıcı verilerini güvenli olarak kaydet"""
        user_file = self.get_user_file(user_id)
        data['last_updated'] = datetime.now().isoformat()
        data['user_id'] = user_id
        
        with self.file_lock:
            try:
                # Geçici dosyaya yaz, sonra taşı (atomic operation)
                temp_file = user_file + '.tmp'
                with open(temp_file, 'w', encoding='utf-8') as f:
                    json.dump(data, f, ensure_ascii=False, indent=2)
                
                # Windows'ta rename işlemi
                if os.path.exists(user_file):
                    os.remove(user_file)
                os.rename(temp_file, user_file)
                
            except Exception as e:
                print(f"❌ Kullanıcı verisi kaydetme hatası - {user_id}: {str(e)}")
                # Geçici dosyayı temizle
                if os.path.exists(temp_file):
                    try:
                        os.remove(temp_file)
                    except:
                        pass
    
    def load_user_data(self, user_id):
        """Kullanıcı verilerini güvenli olarak yükle"""
        user_file = self.get_user_file(user_id)
        
        with self.file_lock:
            if os.path.exists(user_file):
                try:
                    with open(user_file, 'r', encoding='utf-8') as f:
                        return json.load(f)
                except Exception as e:
                    print(f"❌ Kullanıcı verisi yükleme hatası - {user_id}: {str(e)}")
                    return {}
            return {}
    
    async def create_safe_telethon_client(self, user_id, user_data):
        """Güvenli Telethon client oluştur"""
        session_lock = self.get_user_session_lock(user_id)
        
        with session_lock:
            try:
                # Eğer zaten bir client varsa, onu güvenli şekilde kapat
                if user_id in self.telethon_clients:
                    print(f"🔄 Mevcut client kapatılıyor - {user_id}")
                    await self.safe_disconnect_client(user_id)
                    await asyncio.sleep(2)  # Daha uzun bekleme
                
                session_file = self.get_safe_session_file(user_id)
                
                # Session dosyasının bulunduğu klasöre tam erişim ver
                try:
                    if not os.path.exists(self.users_dir):
                        os.makedirs(self.users_dir, mode=0o755)
                    
                    # Eğer session dosyası varsa, yazılabilir yap
                    if os.path.exists(session_file):
                        os.chmod(session_file, stat.S_IWRITE | stat.S_IREAD)
                    
                    # Aynı şekilde .session-journal dosyası için de
                    journal_file = session_file + '-journal'
                    if os.path.exists(journal_file):
                        os.chmod(journal_file, stat.S_IWRITE | stat.S_IREAD)
                        
                except Exception as chmod_error:
                    print(f"⚠️ Dosya izinleri ayarlanamadı - {user_id}: {str(chmod_error)}")
                
                # Sadece 1 deneme yap, başarısız olursa session'ı sil
                try:
                    client = TelegramClient(
                        session_file, 
                        user_data['api_id'], 
                        user_data['api_hash']
                    )
                    await client.connect()
                    return client
                except Exception as e:
                    # Herhangi bir hata varsa session dosyasını sil ve yeniden dene
                    print(f"⚠️ Session hatası - {user_id}: {str(e)[:100]}")
                    
                    try:
                        if os.path.exists(session_file):
                            os.chmod(session_file, stat.S_IWRITE)
                            os.remove(session_file)
                        journal_file = session_file + '-journal'
                        if os.path.exists(journal_file):
                            os.chmod(journal_file, stat.S_IWRITE)
                            os.remove(journal_file)
                        print(f"🔄 Session dosyası silindi - {user_id}")
                    except Exception as del_error:
                        print(f"⚠️ Session dosyası silinemedi - {user_id}: {str(del_error)}")
                    
                    # Temiz session ile yeniden dene
                    await asyncio.sleep(1)
                    client = TelegramClient(
                        session_file, 
                        user_data['api_id'], 
                        user_data['api_hash']
                    )
                    await client.connect()
                    return client
                
            except Exception as e:
                print(f"❌ Telethon client oluşturma hatası - {user_id}: {str(e)}")
                raise e
    
    async def try_auto_login(self, user_id, user_data):
        """Bot restart sonrası otomatik giriş dene"""
        try:
            # Session dosyası var mı kontrol et
            session_file = self.get_safe_session_file(user_id)
            if not os.path.exists(session_file):
                print(f"⚠️ Session dosyası bulunamadı - {user_id}")
                return False
            
            # API bilgileri var mı kontrol et
            if not all([user_data.get('api_id'), user_data.get('api_hash'), user_data.get('phone_number')]):
                print(f"⚠️ API bilgileri eksik - {user_id}")
                return False
            
            print(f"🔄 Otomatik giriş deneniyor - {user_id}")
            
            # Client oluştur
            client = await self.create_safe_telethon_client(user_id, user_data)
            
            # Authorization kontrolü
            if await client.is_user_authorized():
                print(f"✅ Otomatik giriş başarılı - {user_id}")
                user_data['phone_verified'] = True
                user_data['session_verified'] = True
                user_data['auto_login_success'] = datetime.now().isoformat()
                self.save_user_data(user_id, user_data)
                
                # Client'ı güvenli şekilde kapat (sadece test amaçlı açtık)
                await self.safe_disconnect_client(user_id)
                return True
            else:
                print(f"⚠️ Session süresi dolmuş - {user_id}")
                
                # Session'ı yenilemeyi dene
                try:
                    await client.start(phone=user_data['phone_number'])
                    print(f"✅ Session yenilendi - {user_id}")
                    user_data['phone_verified'] = True
                    user_data['session_verified'] = True
                    user_data['session_renewed'] = datetime.now().isoformat()
                    self.save_user_data(user_id, user_data)
                    
                    await self.safe_disconnect_client(user_id)
                    return True
                except Exception as e:
                    print(f"❌ Session yenilenemedi - {user_id}: {str(e)}")
                    await self.safe_disconnect_client(user_id)
                    return False
                    
        except Exception as e:
            print(f"❌ Otomatik giriş hatası - {user_id}: {str(e)}")
            return False
    
    async def initialize_all_sessions(self):
        """Bot başlangıcında tüm kullanıcıların session'larını kontrol et"""
        print("🔄 Session'lar kontrol ediliyor...")
        
        if not os.path.exists(self.users_dir):
            print("📁 Kullanıcı verileri klasörü bulunamadı")
            return
        
        successful_logins = 0
        failed_logins = 0
        
        # Tüm kullanıcı dosyalarını tara
        for filename in os.listdir(self.users_dir):
            if filename.endswith('.json') and filename.startswith('user_'):
                try:
                    user_id = int(filename.replace('user_', '').replace('.json', ''))
                    user_data = self.load_user_data(user_id)
                    
                    if user_data and user_data.get('phone_verified'):
                        print(f"🔍 Session kontrol ediliyor - {user_id}")
                        
                        if await self.try_auto_login(user_id, user_data):
                            successful_logins += 1
                            print(f"✅ Session hazır - {user_id}")
                            
                            # Otomatik gönderim recovery (Cloud platform için)
                            if self.is_cloud_platform and user_data.get('auto_send_active'):
                                print(f"🔄 Otomatik gönderim recovery - {user_id}")
                                await self.restore_auto_send(user_id, user_data)
                        else:
                            failed_logins += 1
                            print(f"❌ Session geçersiz - {user_id}")
                            
                except Exception as e:
                    print(f"⚠️ Kullanıcı session kontrol hatası - {filename}: {str(e)}")
                    failed_logins += 1
        
        print(f"📊 Session kontrol sonucu: ✅ {successful_logins} başarılı, ❌ {failed_logins} başarısız")
    
    async def restore_auto_send(self, user_id, user_data):
        """Container restart sonrası otomatik gönderimi restore et"""
        try:
            # Gerekli alanları kontrol et
            required = ['api_id', 'api_hash', 'phone_number', 'groups', 'message']
            if not all(user_data.get(field) for field in required):
                print(f"❌ Auto-send restore - eksik veriler - {user_id}")
                return
            
            # Zaten aktif task var mı kontrol et
            if user_id in self.active_tasks and not self.active_tasks[user_id].done():
                print(f"⚠️ Auto-send zaten aktif - {user_id}")
                return
            
            print(f"🔄 Auto-send restore başlıyor - {user_id}")
            
            # Auto-send task'ını başlat
            task = asyncio.create_task(self.auto_send_loop(user_id))
            self.active_tasks[user_id] = task
            
            # Restore bilgilerini kaydet
            user_data['auto_send_restored'] = datetime.now().isoformat()
            user_data['restore_count'] = user_data.get('restore_count', 0) + 1
            self.save_user_data(user_id, user_data)
            
            print(f"✅ Auto-send restore başarılı - {user_id}")
            
            # Kullanıcıya bildirim gönder
            try:
                interval_minutes = user_data.get('send_interval_minutes', 60)
                hours = interval_minutes // 60
                minutes = interval_minutes % 60
                interval_display = f"{hours} saat {minutes} dakika" if hours > 0 else f"{minutes} dakika"
                
                await self.app.bot.send_message(
                    chat_id=user_id,
                    text=f"🔄 Otomatik gönderim restore edildi!\n\n"
                         f"✅ Bot yeniden başladı\n"
                         f"⏰ Gönderim aralığı: {interval_display}\n"
                         f"🎯 Container restart sonrası otomatik devam\n\n"
                         f"💡 Sistem 7/24 aktif kalacak şekilde optimize edildi!"
                )
            except Exception as notify_error:
                print(f"⚠️ Restore bildirim hatası - {user_id}: {str(notify_error)}")
                
        except Exception as e:
            print(f"❌ Auto-send restore hatası - {user_id}: {str(e)}")
            
            # Restore başarısız durumunda flag'i temizle
            user_data['auto_send_active'] = False
            user_data['restore_error'] = str(e)
            user_data['restore_error_time'] = datetime.now().isoformat()
            self.save_user_data(user_id, user_data)
    
    async def safe_disconnect_client(self, user_id):
        """Güvenli client bağlantısını kes"""
        if user_id in self.telethon_clients:
            session_lock = self.get_user_session_lock(user_id)
            with session_lock:
                try:
                    client = self.telethon_clients[user_id]
                    if client and client.is_connected():
                        # Telethon client'ı güvenli şekilde kapat
                        try:
                            # Önce pending update'leri iptal et
                            if hasattr(client, '_sender') and client._sender:
                                try:
                                    await asyncio.wait_for(client._sender.disconnect(), timeout=3.0)
                                except asyncio.TimeoutError:
                                    print(f"⚠️ Sender disconnect timeout - {user_id}")
                                except Exception as e:
                                    print(f"⚠️ Sender disconnect hatası - {user_id}: {str(e)}")
                            
                            # Ana client'ı kapat
                            await asyncio.wait_for(client.disconnect(), timeout=5.0)
                            
                        except asyncio.TimeoutError:
                            print(f"⚠️ Client disconnect timeout - {user_id}")
                            # Zorla kapatmaya çalış
                            try:
                                if hasattr(client, '_connection') and client._connection:
                                    await client._connection.disconnect()
                            except:
                                pass
                        except Exception as disconnect_error:
                            print(f"⚠️ Client disconnect hatası - {user_id}: {str(disconnect_error)}")
                    
                    del self.telethon_clients[user_id]
                    print(f"✅ Client güvenli şekilde kapatıldı - {user_id}")
                    
                    # Kısa bekleme - sistem kaynaklarının temizlenmesi için
                    await asyncio.sleep(0.5)
                    
                except Exception as e:
                    print(f"⚠️ Client kapatma hatası - {user_id}: {str(e)}")
                    # Zorla temizle
                    try:
                        del self.telethon_clients[user_id]
                    except:
                        pass
    
    async def cleanup_user_sessions(self, user_id):
        """Belirli bir kullanıcının tüm session'larını temizle"""
        try:
            print(f"🧹 Session temizliği başlıyor - {user_id}")
            
            # Aktif task'ı iptal et
            if user_id in self.active_tasks:
                try:
                    task = self.active_tasks[user_id]
                    if not task.done():
                        task.cancel()
                        try:
                            await asyncio.wait_for(task, timeout=2.0)
                        except (asyncio.CancelledError, asyncio.TimeoutError):
                            pass
                    del self.active_tasks[user_id]
                    print(f"✅ Aktif task iptal edildi - {user_id}")
                except Exception as e:
                    print(f"⚠️ Task iptal hatası - {user_id}: {str(e)}")
            
            # Aktif client'ı kapat
            if user_id in self.telethon_clients:
                try:
                    client = self.telethon_clients[user_id]
                    if client and client.is_connected():
                        # Aggressive disconnect
                        try:
                            await asyncio.wait_for(client.disconnect(), timeout=3.0)
                        except asyncio.TimeoutError:
                            print(f"⚠️ Client disconnect timeout - {user_id}")
                            # Zorla kapat
                            try:
                                if hasattr(client, '_connection') and client._connection:
                                    await client._connection.disconnect()
                            except:
                                pass
                    del self.telethon_clients[user_id]
                    print(f"✅ Client kapatıldı - {user_id}")
                except Exception as e:
                    print(f"⚠️ Client kapatma hatası - {user_id}: {str(e)}")
                    try:
                        del self.telethon_clients[user_id]
                    except:
                        pass
            
            # User states'i temizle
            if user_id in self.user_states:
                try:
                    del self.user_states[user_id]
                    print(f"✅ User state temizlendi - {user_id}")
                except Exception as e:
                    print(f"⚠️ User state temizleme hatası - {user_id}: {str(e)}")
            
            # Session lock'u temizle
            if user_id in self.session_locks:
                try:
                    del self.session_locks[user_id]
                    print(f"✅ Session lock temizlendi - {user_id}")
                except Exception as e:
                    print(f"⚠️ Session lock temizleme hatası - {user_id}: {str(e)}")
            
            # Kısa bekleme - sistem kaynaklarının temizlenmesi için
            await asyncio.sleep(1)
            print(f"✅ Session temizliği tamamlandı - {user_id}")
            
        except Exception as e:
            print(f"⚠️ User session cleanup hatası - {user_id}: {str(e)}")

    async def global_cleanup(self):
        """Tüm açık session'ları ve task'ları temizle"""
        try:
            print("🧹 Global cleanup başlıyor...")
            
            # Heartbeat task'ını iptal et
            if self.heartbeat_task and not self.heartbeat_task.done():
                try:
                    self.heartbeat_task.cancel()
                    await asyncio.wait_for(self.heartbeat_task, timeout=1.0)
                    print("✅ Heartbeat task iptal edildi")
                except:
                    print("⚠️ Heartbeat task zorla iptal edildi")
            
            # Tüm aktif task'ları iptal et
            for user_id, task in list(self.active_tasks.items()):
                try:
                    if not task.done():
                        task.cancel()
                        try:
                            await asyncio.wait_for(task, timeout=1.0)
                        except:
                            pass
                    print(f"✅ Task iptal edildi - {user_id}")
                except Exception as e:
                    print(f"⚠️ Task iptal hatası - {user_id}: {str(e)}")
            
            self.active_tasks.clear()
            
            # Tüm client'ları kapat
            for user_id, client in list(self.telethon_clients.items()):
                try:
                    if client and client.is_connected():
                        await asyncio.wait_for(client.disconnect(), timeout=2.0)
                    print(f"✅ Client kapatıldı - {user_id}")
                except Exception as e:
                    print(f"⚠️ Client kapatma hatası - {user_id}: {str(e)}")
            
            self.telethon_clients.clear()
            self.session_locks.clear()
            self.user_states.clear()
            
            # Pending task'ları bekle
            pending_tasks = [task for task in asyncio.all_tasks() if not task.done()]
            if pending_tasks:
                print(f"⏳ {len(pending_tasks)} pending task bekleniyor...")
                await asyncio.sleep(2)
            
            print("✅ Global cleanup tamamlandı")
            
        except Exception as e:
            print(f"⚠️ Global cleanup hatası: {str(e)}")
    
    def cleanup_old_sessions(self):
        """Eski session dosyalarını temizle"""
        try:
            session_pattern = os.path.join(self.users_dir, "user_*_session.session*")
            session_files = glob.glob(session_pattern)
            
            for session_file in session_files:
                try:
                    # Dosya izinlerini kontrol et ve değiştir
                    if os.path.exists(session_file):
                        # Dosyayı yazılabilir yap
                        os.chmod(session_file, stat.S_IWRITE | stat.S_IREAD)
                        
                        # 7 günden eski session dosyalarını sil
                        if os.path.getmtime(session_file) < time.time() - (7 * 24 * 3600):
                            os.remove(session_file)
                            print(f"🗑️ Eski session dosyası silindi: {os.path.basename(session_file)}")
                except Exception as e:
                    print(f"⚠️ Session dosyası silinemedi {session_file}: {str(e)}")
        except Exception as e:
            print(f"⚠️ Session temizleme hatası: {str(e)}")
    
    async def process_group_list(self, raw_groups, user_id):
        """Grup listesini işle ve doğrula"""
        processed_groups = []
        
        for group in raw_groups:
            group = group.strip()
            if not group:
                continue
                
            # Farklı grup formatlarını işle
            processed_group = self.parse_group_identifier(group)
            if processed_group:
                processed_groups.append(processed_group)
                print(f"✅ Grup eklendi - {user_id}: {processed_group['display']}")
            else:
                print(f"⚠️ Geçersiz grup formatı - {user_id}: {group}")
        
        return processed_groups
    
    def parse_group_identifier(self, group_input):
        """Grup tanımlayıcısını parse et"""
        group_input = group_input.strip()
        
        # Telegram link formatı: https://t.me/grupadi
        if group_input.startswith('https://t.me/'):
            username = group_input.replace('https://t.me/', '').strip()
            if username:
                return {
                    'type': 'username',
                    'value': username,
                    'display': f"@{username}",
                    'original': group_input
                }
        
        # Grup ID formatı: -1001234567890
        elif group_input.startswith('-100') and group_input[1:].isdigit():
            return {
                'type': 'id',
                'value': int(group_input),
                'display': f"ID: {group_input}",
                'original': group_input
            }
        
        # Telefon numarası formatı: +905551234567
        elif group_input.startswith('+') and len(group_input) > 10:
            return {
                'type': 'phone',
                'value': group_input,
                'display': f"📱 {group_input}",
                'original': group_input
            }
        
        # Username formatı: @grupadi veya grupadi
        elif group_input.startswith('@'):
            username = group_input[1:].strip()
            if username and username.replace('_', '').replace('.', '').isalnum():
                return {
                    'type': 'username',
                    'value': username,
                    'display': f"@{username}",
                    'original': group_input
                }
        
        # Direkt username (@ olmadan)
        elif group_input.replace('_', '').replace('.', '').isalnum():
            return {
                'type': 'username',
                'value': group_input,
                'display': f"@{group_input}",
                'original': group_input
            }
        
        # Negatif ID (başka format)
        elif group_input.startswith('-') and group_input[1:].isdigit():
            return {
                'type': 'id',
                'value': int(group_input),
                'display': f"ID: {group_input}",
                'original': group_input
            }
        
        return None
    
    def format_group_display(self, group_data):
        """Grup verilerini görüntülenebilir formata çevir"""
        if isinstance(group_data, dict):
            return group_data.get('display', str(group_data.get('value', 'Bilinmeyen')))
        return str(group_data)
    
    async def validate_group_access(self, client, group_data):
        """Gruba erişim olup olmadığını kontrol et"""
        try:
            if group_data['type'] == 'id':
                entity = await client.get_entity(group_data['value'])
            elif group_data['type'] == 'username':
                entity = await client.get_entity(group_data['value'])
            elif group_data['type'] == 'phone':
                entity = await client.get_entity(group_data['value'])
            else:
                return False, "Desteklenmeyen grup türü"
            
            # Grup bilgilerini al
            if hasattr(entity, 'title'):
                group_title = entity.title
            else:
                group_title = "Bilinmeyen Grup"
            
            return True, group_title
            
        except Exception as e:
            error_msg = str(e)
            if "No user has" in error_msg:
                return False, "Kullanıcı bulunamadı"
            elif "cannot find any entity" in error_msg:
                return False, "Grup bulunamadı"
            elif "CHAT_ADMIN_REQUIRED" in error_msg:
                return False, "Admin yetkisi gerekli"
            elif "USER_BANNED_IN_CHANNEL" in error_msg:
                return False, "Gruptan yasaklandınız"
            else:
                return False, f"Erişim hatası: {error_msg[:50]}"
    
    def get_phone_code_keyboard(self):
        """Telefon kodu için sayısal klavye"""
        keyboard = [
            [InlineKeyboardButton("1", callback_data="code_1"), 
