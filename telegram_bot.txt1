    async def safe_edit_message(self, query, text, reply_markup=None):
        """Güvenli mesaj düzenleme - timeout ve eski query hatalarını yakala"""
        try:
            await query.edit_message_text(text=text, reply_markup=reply_markup)
            return True
        except Exception as e:
            error_msg = str(e)
            if any(err in error_msg for err in [
                "Query is too old", 
                "response timeout expired", 
                "query id is invalid",
                "Message is not modified"
            ]):
                print(f"⚠️ Mesaj düzenleme atlandı: {error_msg[:50]}")
                return False
            else:
                print(f"❌ Mesaj düzenleme hatası: {error_msg}")
                # Kritik olmayan hatalar için yeniden deneme
                try:
                    await asyncio.sleep(0.5)
                    await query.edit_message_text(text=text, reply_markup=reply_markup)
                    return True
                except:
                    print(f"❌ Mesaj düzenleme tekrar denemesi başarısız")
                    return False
    
